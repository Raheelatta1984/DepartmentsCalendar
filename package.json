{
  "name": "departments-calendar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Enterprise-wide department activity, workload and roadmap portal",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "smoke": "vite-node scripts/smoke.mjs",
    "smoke:store": "vite-node scripts/store-smoke.mjs",
    "smoke:capitalisation": "vite-node scripts/capitalisation-smoke.mjs",
    "test": "node --test tests/*.test.mjs && vite-node scripts/workspace-smoke.mjs && vite-node scripts/capitalisation-smoke.mjs && vite-node scripts/standup-smoke.mjs && vite-node scripts/tenancy-leave-smoke.mjs && vite-node scripts/leave-store-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke && npm run smoke:store",
    "db:restore": "node --env-file-if-exists=.env scripts/restore-workspace.mjs",
    "db:init": "vite-node scripts/seed-workspace.mjs",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "infra:logs": "docker-compose logs -f",
    "infra:test": "vite-node scripts/infrastructure-smoke.mjs",
    "infra:health": "vite-node scripts/infrastructure-health.mjs",
    "id:test": "vite-node scripts/id-generator-test.mjs",
    "sharding:test": "vite-node scripts/sharding-test.mjs",
    "smoke:tenancy": "vite-node scripts/tenancy-leave-smoke.mjs",
    "smoke:leave": "vite-node scripts/leave-store-smoke.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.61.0",
    "memcached": "^2.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/memcached": "^2.2.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
