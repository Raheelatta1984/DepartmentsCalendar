# Keep secrets here only for local development. Never commit .env or use VITE_ prefixes.
# Without DATABASE_URL the app clearly stays in browser-only demo mode.
# In Vercel, set these under Project > Settings > Environment Variables and redeploy.
# DATABASE_URL=postgresql://ROLE:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# WORKSPACE_PASSWORD=choose-a-unique-password-of-at-least-16-characters
# SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters

# Optional: exact HTTPS origin (no trailing slash). Usually omit this on Vercel
# so production and preview deployments each accept their own same-origin requests.
# PUBLIC_ORIGIN=https://your-existing-project.vercel.app
