# Keep secrets here only for local development. Never commit .env or use VITE_ prefixes.
# Without DATABASE_URL the app clearly stays in browser-only demo mode.
# In Vercel, set these under Project > Settings > Environment Variables and redeploy.

# Database (Neon PostgreSQL)
# Use the pooled endpoint (contains -pooler in hostname) for PgBouncer connection pooling
DATABASE_URL=postgresql://ROLE:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: Direct connection string (bypasses pooler, for admin operations)
# DATABASE_DIRECT_URL=postgresql://ROLE:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require

# Workspace Authentication (REQUIRED for shared mode)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
WORKSPACE_PASSWORD=choose-a-unique-password-of-at-least-16-characters

# Session Secret (REQUIRED for shared mode)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters

# Optional: Exact HTTPS origin (no trailing slash). Usually omit on Vercel
# so production and preview deployments each accept their own same-origin requests.
# PUBLIC_ORIGIN=https://your-existing-project.vercel.app

# Request guard (server/request-guard.mjs). All optional; defaults are sensible.
# Per-client, per-route sliding-window limits (requests per minute).
# RATE_LIMIT_CONFIG_PER_MINUTE=120
# RATE_LIMIT_SESSION_LOGIN_PER_MINUTE=10
# RATE_LIMIT_SESSION_LOGOUT_PER_MINUTE=30
# RATE_LIMIT_WORKSPACE_READ_PER_MINUTE=60
# RATE_LIMIT_WORKSPACE_WRITE_PER_MINUTE=40
# RATE_LIMIT_UNKNOWN_PER_MINUTE=20
# RATE_LIMIT_GLOBAL_PER_MINUTE=240
# In-memory workspace snapshot cache lifetime (ms); 0 disables the micro-cache.
# WORKSPACE_READ_CACHE_MS=5000
# Emergency kill switch for rate limiting only (caches stay on).
# REQUEST_GUARD_DISABLED=1

# =============================================================================
# NEW INFRASTRUCTURE CONFIGURATION
# =============================================================================

# Read Replicas (comma-separated Neon read replica connection strings)
# Enable for read-heavy workloads to distribute SELECT queries
# READ_REPLICA_URLS=postgresql://ROLE:PASSWORD@REPLICA1-pooler.REGION.aws.neon.tech/neondb?sslmode=require,postgresql://ROLE:PASSWORD@REPLICA2-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Memcached Hosts (comma-separated host:port)
# For distributed caching of read queries
# MEMCACHED_HOSTS=localhost:11211
# MEMCACHED_PREFIX=orbit:

# Image Sharding Machines (JSON array)
# Define storage machines for logical sharding
# IMAGE_SHARDING_MACHINES=[{"id":"storage-1","region":"us-east-1","zone":"a","capacity":100},{"id":"storage-2","region":"us-east-1","zone":"b","capacity":100},{"id":"storage-3","region":"eu-west-1","zone":"a","capacity":100}]

# Shard ID for this instance (0-8191)
# Used by NextID generator for distributed ID generation
# SHARD_ID=0

# =============================================================================
# DOCKER COMPOSE DEFAULTS (for local development)
# =============================================================================

# Postgres password for docker-compose
# POSTGRES_PASSWORD=neon_password

# Workspace password for docker-compose (min 16 chars)
# WORKSPACE_PASSWORD=development_password_min_16_chars

# Session secret for docker-compose (min 32 chars)
# SESSION_SECRET=development_session_secret_min_32_chars_long

# Optional Azure DevOps read-only metadata lookup (server only; never VITE_).
# PAT scope: Work Items (Read), restricted to the projects being imported.
# AZURE_DEVOPS_PAT=your-read-only-personal-access-token
# RATE_LIMIT_DEVOPS_LOOKUP_PER_MINUTE=10

# Optional: server-side one-on-one summaries (shared, signed-in workspace only).
# Discussion notes are sent to the configured provider only when a participant requests it.
# OPENAI_API_KEY=
# ONE_ON_ONE_AI_MODEL=gpt-4o-mini
